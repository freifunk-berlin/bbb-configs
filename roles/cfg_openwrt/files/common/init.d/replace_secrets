#!/bin/sh /etc/rc.common
# shellcheck shell=dash disable=SC2169,SC2034

# Script which replaces all secrets, which inline reference to files
# It has to run before the secrets are being used, obviously

START=15

log() {
  logger -t replace_secrets "$1"
}

log_err() {
  logger -t replace_secrets -p daemon.err "$1"
}


boot() {
  log "Iterating over uci config - Checking for tasks"
  missing=""
  secrets=$(uci show | grep "='file:")

  # read the lines whole, values may contain spaces
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    uci_key=${line%%=*}
    uci_value=${line#*=}
    parameter=${uci_value#\'file:}
    parameter=${parameter%\'}

    if [ -r "$parameter" ]; then
      log "Replace $uci_key ($uci_value) by value read from file $parameter"
      uci set "$uci_key=$(cat "$parameter")"
    else
      log_err "Cannot read $parameter, $uci_key stays empty until it is read on the next boot"
      missing="$missing$uci_key
"
    fi
  done <<EOF
$secrets
EOF

  uci commit

  # The file reference must not be used as the secret, e.g. as a wifi key.
  # Cleared without a commit, so the reference is kept for the next boot.
  while IFS= read -r uci_key; do
    [ -n "$uci_key" ] && uci set "$uci_key="
  done <<EOF
$missing
EOF
  log "Done"
}
