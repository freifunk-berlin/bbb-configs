#!/bin/sh /etc/rc.common
# START and USE_PROCD are read by rc.common, the braces are Jinja2
# shellcheck disable=SC2034,SC1083
# Translates babel mesh reachability into BGP AS path prepends, see the header
# of /usr/sbin/bgp_babel_prepend.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/bgp_babel_prepend --plen {{ freifunk_wahlkreis_announcement_prefix }}
	procd_set_param respawn 3600 60 0
	procd_close_instance
}
