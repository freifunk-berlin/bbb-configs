#jinja2: trim_blocks: True, lstrip_blocks: True
{% if airos_dfs_hosts | length > 0 %}
config airos-dfs-reset general
	option interval		'600'
	option reset_sleep	'900'
{% for device in airos_dfs_hosts %}

config device '{{ device | replace('-', '_') }}'
	option target '{{ device_ips[device] }}'
	option username '{{ hostvars[device].username }}'
	option password '{{ hostvars[device].password }}'
	option daytime_limit '{{ hostvars[device].daytime_limit }}'
{% endfor %}
{% endif %}
