config statistics 'statistics'
	option enabled '1'

config server 'server'
	option host 'monitor.berlin.freifunk.net'
	option port '9091'
	option path '/metrics/job/nodes/instance/'

config statistics 'ping'
{% for host in prometheus_push_ping_hosts %}
	list server '{{host}}'
{% endfor %}
{% set interface = networks | selectattr('assignments', 'defined') | selectattr('role', 'in', ['dhcp', 'mgmt', 'mesh', 'tunnel'] ) | first %}
	option interface '{{ interface['prefix'] | ansible.utils.ipaddr(interface['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }}'
