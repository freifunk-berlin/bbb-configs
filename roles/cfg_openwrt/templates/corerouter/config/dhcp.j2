#jinja2: trim_blocks: True, lstrip_blocks: True
{% import 'libraries/network.j2' as libnetwork with context %}
{% set l3_networks = networks | selectattr('assignments', 'defined') | selectattr('assignments', 'contains', inventory_hostname) | list %}
{% set vrf_freifunk_active = role == 'corerouter' and l3_networks | selectattr('direct_internet', 'defined') | selectattr('direct_internet') | list | length > 0 %}
{% set ns = namespace(vrf_member_names=[], default_member_names=[]) %}
{% for network in networks | rejectattr('role', 'in', ['uplink', 'wireless_uplink', 'mesh', 'tunnel', 'ext']) %}
{% if not network.get('direct_internet') %}
{% set ns.vrf_member_names = ns.vrf_member_names + [libnetwork.getUciIfname(network)] %}
{% else %}
{% set ns.default_member_names = ns.default_member_names + [libnetwork.getUciIfname(network)] %}
{% endif %}
{% endfor %}
{% macro dnsmasq_common() %}
	option domainneeded '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'ff'
	option expandhosts '1'
	option authoritative '1'
	option readethers '1'
	option localservice '1'
	option noping '{{ dhcp_no_ping|int if dhcp_no_ping is defined else 1 }}'
	option quietdhcp '1'
	option cachesize '{{ dns_cache_size | default(10000) }}'
{% if not (bird_only | default(true)) %}
	list server '/olsr/'
{% endif %}
{% for _dns_server in dns_servers %}
        list server '{{ _dns_server }}'
{% endfor %}
{% if adblock_enabled | default(false) | bool and adblock_provider | default('fast') == 'lean' %}
	list addnmount '/bin/busybox'
	list addnmount '/var/run/adblock-lean/abl-blocklist.gz'
{% endif %}
{% endmacro %}
config dnsmasq{{ " 'default'" if vrf_freifunk_active else "" }}
{% if vrf_freifunk_active %}
{# Positive scoping, not 'notinterface vrf_freifunk': excluding the VRF master device does NOT
   exclude its slave interfaces' own link-local addresses (fe80::/10 is scope-link, bindable
   regardless of VRF table membership), so this instance would still race vrf_freifunk's own
   instance for switch0.40/switch0.42's fe80 addresses and lose ("Address in use"), permanently
   crash-looping it. dnsmasq itself guarantees the loopback interface stays bound even under a
   positive --interface= restriction (see enumerate_interfaces() in dnsmasq's network.c), so
   127.0.0.1/::1 need no explicit entry here. #}
  {% for name in ns.default_member_names %}
	list interface '{{ name }}'
  {% endfor %}
{% endif %}
{{ dnsmasq_common() }}
{% if vrf_freifunk_active %}
{# dnsmasq is a single default-table process: it can never bind/route to vrf_freifunk member
   addresses (VRF virtualizes the local table too), so DNS/DHCP for those networks needs a
   second instance actually running in that routing context. 'vrf' (procd's 'vrf' instance
   param, see procd.sh/instance.c) is the routing/socket context; 'list interface' below is
   the unrelated, ordinary dnsmasq option selecting which networks this instance serves - the
   VRF master device itself is never a DHCP/DNS interface. #}
config dnsmasq 'vrf_freifunk'
	option vrf 'vrf_freifunk'
  {% for name in ns.vrf_member_names %}
	list interface '{{ name }}'
  {% endfor %}
{{ dnsmasq_common() }}
{% endif %}

{% if not (bird_only | default(true)) %}
{% for network in networks | selectattr('role', 'equalto', 'mgmt') %}
  {% for host, ip_num in network['assignments'].items() %}
config domain '{{ host | replace('-', '_') }}_olsr'
	option name '{{ host }}.olsr'
	option ip '{{ network['prefix'] | ansible.utils.ipaddr(ip_num) | ansible.utils.ipaddr('address') }}'

  {% endfor %}
{% endfor %}
{% endif %}

{% for network in networks | rejectattr('role', 'in', ['uplink', 'wireless_uplink', 'mesh', 'tunnel', 'ext']) %}
    {% set name = libnetwork.getUciIfname(network) %}

config dhcp 'dhcp_{{ name }}'
	option ignore '0'
	option interface '{{ name }}'
    {% if vrf_freifunk_active %}
	option instance '{{ 'default' if network.get('direct_internet') else 'vrf_freifunk' }}'
    {% endif %}
	option ra 'server'
	option dhcpv6 'disabled'
    {% if network['role'] == 'dhcp' %}
	option dhcpv4 'server'
	option force '1'
	option leasetime '5m'
	option start '2'
	option limit '{{ network['prefix'] | ansible.utils.ipaddr('size') -3 }}'
      {% if network.get('direct_internet') %}
        list dhcp_option '121,0.0.0.0/0,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }}'
      {% else %}
        list dhcp_option '121,0.0.0.0/0,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }},10.31.0.0/16,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }},10.36.0.0/16,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }},10.230.0.0/16,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }},10.248.0.0/14,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }},10.30.96.0/19,{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }}'
      {% endif %}
    {% else %}
	option dhcpv4 'disabled'
    {% endif %}


{% if not network.get('no_corerouter_dns_record') %}
config domain 'frei_funk_{{ name }}'
	option name 'frei.funk'
	option ip '{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][inventory_hostname]) | ansible.utils.ipaddr('address') }}'
    {% if vrf_freifunk_active %}
	option instance '{{ 'default' if network.get('direct_internet') else 'vrf_freifunk' }}'
    {% endif %}
    {% endif %}
{% endfor %}

{% for network in networks | selectattr('role','in', ['uplink', 'mesh', 'tunnel']) %}
    {% set name = libnetwork.getUciIfname(network) %}
config dhcp 'dhcp_{{ name }}'
	option interface '{{ name }}'
	option ignore '1'

{% endfor %}

{% for network in networks | selectattr('role','equalto','dhcp') %}
    {% set name = libnetwork.getUciIfname(network) %}
    {% for assignment in network['assignments'] %}
config host '{{ name }}_{{ assignment.replace("-", "_") }}'
	option name '{{ assignment }}'
	option ip '{{ network['prefix'] | ansible.utils.ipaddr(network['assignments'][assignment]) | ansible.utils.ipaddr('address') }}'
    {% if vrf_freifunk_active %}
	option instance '{{ 'default' if network.get('direct_internet') else 'vrf_freifunk' }}'
    {% endif %}
    {% endfor %}
{% endfor %}

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
