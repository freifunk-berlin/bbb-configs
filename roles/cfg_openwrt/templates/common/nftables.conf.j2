#jinja2: trim_blocks: True, lstrip_blocks: True
{% import 'libraries/network.j2' as libnetwork with context %}
#!/usr/sbin/nft -f
{% set profile = wireless_profiles | selectattr('name', 'equalto', wireless_profile) | list | first -%}

{# DISCLAIMER: i'm not very proud of the following. feel free to find more elegant way!
   Basically we need a list of dicts which can be used later on.
network_ifname_map =
  - network: dhcp
    ifname: wlan5-dhcp
  - ..
#}
{% set network_ifname_map = [] %}
{% for wd in wireless_devices | default([]) %}
  {% set wd_ifaces = profile['ifaces'] | default([]) | selectattr('radio', 'contains', wd['name']) %}
  {% if 'devices' in profile %}
    {% set wd_config = profile['devices'] | default([]) | selectattr('radio', 'contains', wd['name']) | first %}
  {% else %}
    {% set wd_config = {} %}
  {% endif %}
  {% set wd_ifaces = profile['ifaces'] | default([]) | selectattr('radio', 'contains', wd['name']) %}
  {% if not wd_config.get('disabled') %}
    {% for iface in wd_ifaces %}
      {% set ifname = wd['ifname_hint'] + '-' + iface['ifname_hint']|default('if' + loop.index0|string) %}
      {% if iface['mode'] == 'ap' %}
        {{ network_ifname_map.append({'network': iface['network'], 'ifname': ifname })}}
      {% elif iface['mode'] == 'mesh' %}
        {% set mesh_nets = networks | selectattr('role','defined') | selectattr('role','equalto','mesh')
          | selectattr('mesh_ap','defined') | selectattr('mesh_ap','equalto',inventory_hostname)
          | selectattr('mesh_radio','equalto', wd['name']) | selectattr('mesh_iface','equalto',iface['ifname_hint']) %}
        {% if mesh_nets | length > 0 %}
          {{ network_ifname_map.append({'network': (mesh_nets|first)['name'], 'ifname': ifname })}}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
{# DISCLAIMER SCOPE END #}

{%- set networks_to_use = networks
    | selectattr('enforce_client_isolation', 'defined')
    | selectattr('enforce_client_isolation')
    | list -%}

{%- if networks_to_use | length > 0 %}
define gw = 02:00:00:00:00:01
define bc = ff:ff:ff:ff:ff:ff
define mc6 = 33:33:00:00:00:00/16

table bridge client_isolation
flush table bridge client_isolation
table bridge client_isolation {
{%- for net in networks_to_use %}
    {%- set name = net['name'] if 'name' in net else net['role'] -%}
    {%- set wifi_ifnames = network_ifname_map
        | selectattr('network', 'equalto', name)
        | map(attribute='ifname')
        | list -%}
    {%- if wifi_ifnames | length > 0 %}
        {%- set wifi = '{ ' + wifi_ifnames | join(', ') + ' }' -%}
        {%- set uplink = libnetwork.getPortIfname(net) if role == 'ap' else '!= ' + wifi -%}
    chain PREROUTING_{{ name }} {
        type filter hook prerouting priority 0; policy accept;
        {{ 'iif' if role == 'ap' else 'iifname' }} {{ uplink }} accept
        iifname {{ wifi }} ether daddr $bc ether daddr set $gw
        iifname {{ wifi }} ether daddr $mc6 ether daddr set $gw
        iifname {{ wifi }} ether daddr $gw accept
        iifname {{ wifi }} drop
    }
    {% endif %}
{% endfor %}
}
{% endif %}

{#
  Reflection filter

  We sometimes receive our own packets back. It happens when a location has
  two or more mesh endpoints (mesh APs or the corerouter's own mesh wifi) on
  the same channel which can hear each other, which is the common case since
  everyone meshes on the same channels. Any suitable obstacle in a single
  antenna's beam can cause reflections too.

  Reflections were observed in 2021 with old 2 GHz Nanostations at Emmauskirche:
  https://github.com/freifunk-berlin/bbb-configs/issues/119

  It usually works like this: corerouter transmits a packet over mesh VLAN 123,
  the respective mesh AP receives it on its bridge and transmits it out over
  the wifi mesh interface. Another mesh AP at the same location receives
  the packet on its wifi mesh interface, and through its bridge puts it
  on mesh VLAN 456, where the same corerouter receives it. The same happens
  between a mesh AP and the corerouter's own mesh wifi interface.

  The corerouter then sees itself as a babel neighbour on the receiving
  interface, and bgpdisco keeps trying to set up a BGP session with itself
  ("Bad BGP identifier"), reconfiguring bird every time. Switches between
  mesh AP and corerouter might also get confused about the same MAC address
  seemingly living on multiple ports.

  So we drop packets coming in from a wifi mesh interface whose source MAC is
  one of the location's routers' mesh MACs. Routers are always wired to their
  mesh APs, so such a packet is a reflection. These MACs are deterministic
  (see getLocationMeshRouterMACs()), so every host can compute the full list:
  - mesh APs drop them on their mesh bridges, before they reach the location.
  - the corerouter drops them on its own mesh wifi interfaces, and on the mesh
    VLANs as a fallback for mesh APs that don't filter (yet).

  This used to be done by learning the source MACs of outgoing packets on each
  mesh AP. That only worked as long as all VLAN interfaces of the corerouter
  shared one MAC address. Learning on the corerouter also ended up blocking
  mesh neighbours, so we don't do that.
#}
{% set location_router_macs = libnetwork.getLocationMeshRouterMACs() | from_json %}
{% if role == 'ap' %}
  {% for network in networks | selectattr('role', 'equalto', 'mesh') | selectattr('name','in', network_ifname_map|map(attribute='network')) %}
    {% set wifi_if = network_ifname_map | selectattr('network', 'equalto', network['name']) | map(attribute='ifname') | first %}
    {% set set_localrouter = 'localrouter_' + network['name'] %}
    {% if loop.first %}

table bridge prevent_mesh_reflection
flush table bridge prevent_mesh_reflection
table bridge prevent_mesh_reflection {
      {% if location_router_macs | length > 0 %}
	set location_routers {
		type ether_addr
		elements = { {{ location_router_macs | join(', ') }} }
	}
      {% endif %}
    {% endif %}
	set {{ set_localrouter }} {
		type ether_addr
		size 5
		flags timeout
	}
	chain POSTROUTING_{{ network['name'] }} {
		type filter hook postrouting priority 0; policy accept;
		oifname {{ wifi_if }} update @{{ set_localrouter }} { ether saddr timeout 1h }
	}
	chain PREROUTING_{{ network['name'] }} {
		type filter hook prerouting priority 0; policy accept;
    {% if location_router_macs | length > 0 %}
		iifname {{ wifi_if }} ether saddr @location_routers counter drop
    {% endif %}
		iifname {{ wifi_if }} ether saddr @{{ set_localrouter }} counter drop
	}
    {% if loop.last %}
}
    {% endif %}
  {% endfor %}
{% elif location_router_macs | length > 0 %}
  {% set mesh_ifnames = [] %}
  {% for network in networks | selectattr('role', 'equalto', 'mesh') | selectattr('mesh_ap', 'defined') %}
    {% if network['mesh_ap'] == inventory_hostname %}
      {% set _ = mesh_ifnames.extend(network_ifname_map | selectattr('network', 'equalto', network['name']) | map(attribute='ifname')) %}
    {% else %}
      {% set _ = mesh_ifnames.append(libnetwork.getPortIfname(network)) %}
    {% endif %}
  {% endfor %}
  {% if mesh_ifnames | length > 0 %}

table inet prevent_mesh_reflection
flush table inet prevent_mesh_reflection
table inet prevent_mesh_reflection {
	set location_routers {
		type ether_addr
		elements = { {{ location_router_macs | join(', ') }} }
	}
	chain PREROUTING {
		type filter hook prerouting priority raw; policy accept;
		iifname { {{ mesh_ifnames | map('to_json') | join(', ') }} } ether saddr @location_routers counter drop
	}
}
  {% endif %}
{% endif %}
