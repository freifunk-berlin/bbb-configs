#jinja2: trim_blocks: True, lstrip_blocks: True

{%- set profiles = snmp_hosts | default([]) | map('extract', hostvars) | map(attribute='snmp_profile') | list | unique %}

{%- if profiles | length > 0 %}
LoadPlugin snmp
<Plugin snmp>
{% endif %}

{%- for profile_name in profiles %}
  {% for metric_name,metric in collectd_snmp_profiles[profile_name].items() %}
    <Data "{{ profile_name }}_{{ metric_name }}">
    {% for opt,val in metric.items() %}
        {{ opt }} {{ val|string|lower if val|string == 'True' or val|string =='False' or val is number else  "\"" + val|string + "\"" }}
    {% endfor %}
    </Data>
  {% endfor %}
{% endfor %}



{% for name in snmp_hosts | default([]) %}
{%   set host = hostvars[name] %}
    <Host "{{ name }}">
        Address "{{ device_ips[name] }}"
        Version 1
        Interval 30
        Community '{{ host.snmp_community | default('public') }}'
  {% for metric_name in collectd_snmp_profiles[host.snmp_profile] %}
        Collect "{{ host.snmp_profile }}_{{ metric_name }}"
  {% endfor %}
    </Host>
{% endfor %}
{% if profiles | length > 0 %}
</Plugin>
{% endif %}
