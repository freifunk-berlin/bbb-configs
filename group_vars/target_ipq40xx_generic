---

multicore: true

target__packages__to_merge:
  # Work around ipq40xx ethernet instabilities
  - naywatch

# Kernel default is 'performance'; ondemand's own tunables below need the
# ondemand/ directory to exist first, which cpu_governor guarantees by being
# applied before sysfs_overrides (see the "sysfs overrides and CPU governor"
# section in DEVELOPER.md). Without this, the sysfs_overrides writes below
# fail at boot since ondemand/ doesn't exist yet under the default governor.
cpu_governor: ondemand
sysfs_overrides:
  - path: /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    value: 200000
  - path: /sys/devices/system/cpu/cpufreq/ondemand/sampling_rate
    value: 1000000
  - path: /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor
    value: 10
  - path: /sys/devices/system/cpu/cpufreq/ondemand/up_threshold
    value: 50
